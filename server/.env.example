# Server Configuration
PORT=5000
NODE_ENV=development

# PostgreSQL Database Connection
DATABASE_URL="postgresql://postgres:password@localhost:5432/nutrichef_db?schema=public"

# JWT Authentication
JWT_SECRET="your_jwt_secret_key_change_in_production"
JWT_EXPIRES_IN="7d"

# Google OAuth 2.0
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"

# Frontend URL (for CORS and Password Reset Links)
FRONTEND_URL="http://localhost:5173"

# SMTP Email Configuration (Password Reset)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-specific-password"
EMAIL_FROM="NutriChef <noreply@nutrichef.com>"
